/**
* Đồng bộ danh sách người dùng với Backend Server
*/
export const syncUsersWithBackend = async () => {
	try {
		const response = await fetch("/api/auth/users");
		if (response.ok) {
			const serverUsers = await response.json();
			if (Array.isArray(serverUsers)) {
				const deletedList = getStored(AUTH_STORAGE_KEYS.DELETED_USERS, []);
				const isUserDeleted = (id) => {
					if (!id) return false;
					const cleanId = String(id).trim();
					return deletedList.some((d) => cleanId && String(d.id).trim() === cleanId);
				};
				// Nếu một email đang hoạt động trên server, giải phóng email đó khỏi deletedList
				const serverEmails = new Set(serverUsers.map((u) => (u.email || "").toLowerCase().trim()));
				let deletedModified = false;
				const updatedDeletedList = deletedList.map((item) => {
					if (item.email && serverEmails.has((item.email || "").toLowerCase().trim())) {
						deletedModified = true;
						return {
							...item,
							email: ""
						};
					}
					return item;
				});
				if (deletedModified) {
					setStored(AUTH_STORAGE_KEYS.DELETED_USERS, updatedDeletedList);
				}
				const localUsers = getUsers();
				const serverUserIds = new Set(serverUsers.map((u) => String(u.id).trim()));
				const serverUserEmails = new Set(serverUsers.map((u) => (u.email || "").toLowerCase().trim()));
				// Cập nhật hoặc bổ sung tài khoản từ server
				serverUsers.forEach((su) => {
					if (isUserDeleted(su.id)) return;
					const idx = localUsers.findIndex((lu) => String(lu.id).trim() === String(su.id).trim() || (lu.email || "").toLowerCase().trim() === (su.email || "").toLowerCase().trim());
					if (idx !== -1) {
						localUsers[idx] = {
							...localUsers[idx],
							...su
						};
					} else {
						localUsers.push(su);
					}
				});
				// Loại bỏ các tài khoản đã bị xóa trên server

const getStored = (key, fallback) => {
	try {
		const item = localStorage.getItem(key);
		if (!item) return fallback;
		return JSON.parse(item);
	} catch {
		return fallback;
	}
};
const setStored = (key, value) => {
	try {
		localStorage.setItem(key, JSON.stringify(value));
	} catch (error) {
		console.error(`Error saving ${key}:`, error);
	}
};
// Chuẩn hóa một bản ghi user từ dữ liệu cũ sang định dạng bảo mật RBAC v2
const normalizeUserRecord = (user) => {
	if (!user) return null;
	let role = user.role;
	if (role === "CLINIC_ADMIN" || role === "vet") role = ROLES.VET_DOCTOR;
	if (role === "OWNER") role = ROLES.PET_OWNER;
	if (role !== ROLES.SYSTEM_ADMIN && role !== ROLES.VET_DOCTOR && role !== ROLES.PET_OWNER) {
		role = ROLES.PET_OWNER;
	}
	let vetStatus = user.vetStatus;
	if (role === ROLES.VET_DOCTOR && !vetStatus) {
		vetStatus = VET_STATUS.APPROVED;
	} else if (role !== ROLES.VET_DOCTOR) {
		vetStatus = null;
	}
	// Đảm bảo ID ổn định kiểu chuỗi, không sinh ID ngẫu nhiên mới mỗi lần chuẩn hóa
	const cleanId = user.id ? String(user.id).trim() : `user_${Date.now()}`;
	return {
		id: cleanId,
		name: (user.name || "Người dùng PetCare").trim(),
		email: (user.email || "").trim().toLowerCase(),
		password: user.password || "User@123456",
		phone: user.phone || "",
		address: user.address || "Việt Nam",
		role,
		isLocked: Boolean(user.isLocked),
		vetStatus,
		mustChangePassword: Boolean(user.mustChangePassword),
		avatar: user.avatar || (role === ROLES.SYSTEM_ADMIN ? INITIAL_SYSTEM_ADMIN.avatar : role === ROLES.VET_DOCTOR ? INITIAL_VET_DOCTOR.avatar : INITIAL_PET_OWNER.avatar),
		createdAt: user.createdAt || new Date().toISOString(),
		passwordChangedAt: user.passwordChangedAt || null
	};
};
// Lấy danh sách users hệ thống kèm đồng bộ hóa và ngăn chặn tài khoản đã xóa tự tái sinh
export const getUsers = () => {
	const defaultSeeds = [
		INITIAL_SYSTEM_ADMIN,
		INITIAL_VET_DOCTOR,
		INITIAL_PET_OWNER
	];
	let users = getStored(AUTH_STORAGE_KEYS.USERS, null);
	const deletedList = getStored(AUTH_STORAGE_KEYS.DELETED_USERS, []);
	// Kiểm tra tài khoản đã bị xóa theo ID duy nhất (không chặn vĩnh viễn email)
	const isUserDeleted = (id) => {
		if (!id) return false;
		const cleanId = String(id).trim();
		return deletedList.some((d) => cleanId && String(d.id).trim() === cleanId);
	};
	// Kiểm tra tài khoản mẫu hệ thống đã bị xóa chưa để ngăn tự tái sinh
	const isSeedDeleted = (seedId) => {
		if (!seedId) return false;
		const cleanId = String(seedId).trim();
		return deletedList.some((d) => cleanId && String(d.id).trim() === cleanId);
	};
	// Nhập bổ sung người dùng từ petcare_registered_users cũ nếu có (bỏ qua nếu đã bị xóa)
	const legacyRegistered = getStored("petcare_registered_users", []);
	const allRaw = Array.isArray(users) ? [...users] : [];
	if (Array.isArray(legacyRegistered) && legacyRegistered.length > 0) {
		legacyRegistered.forEach((leg) => {
			if (leg?.email && !isUserDeleted(leg.id) && !allRaw.some((u) => (u.email || "").toLowerCase().trim() === (leg.email || "").toLowerCase().trim())) {
				allRaw.push(leg);
			}
		});
	}
	// Lọc bỏ tài khoản đã nằm trong danh sách đã xóa theo ID
	const activeRaw = allRaw.filter((u) => !isUserDeleted(u.id));
	if (activeRaw.length === 0 && deletedList.length === 0) {
		setStored(AUTH_STORAGE_KEYS.USERS, defaultSeeds);
		return defaultSeeds;
	}
	let updated = false;
	const normalizedList = activeRaw.map(normalizeUserRecord).filter(Boolean);
	// Chỉ thêm seed nếu tài khoản seed đó CHƯA TỪNG bị xóa và chưa có ai dùng email đó
	defaultSeeds.forEach((defUser) => {
		if (isSeedDeleted(defUser.id)) {
			return;
		}
		const existingIndex = normalizedList.findIndex((u) => (u.email || "").toLowerCase().trim() === defUser.email.toLowerCase().trim());
		if (existingIndex === -1) {
			normalizedList.unshift(defUser);
			updated = true;
		} else {
			// Đảm bảo admin không bị mất quyền role system_admin do migrate nhầm
			if (defUser.email.toLowerCase() === "admin@petcare.ai" && normalizedList[existingIndex].role !== ROLES.SYSTEM_ADMIN) {
				normalizedList[existingIndex].role = ROLES.SYSTEM_ADMIN;
				updated = true;
			}
		}
	});
	if (updated || normalizedList.length !== allRaw.length) {
		setStored(AUTH_STORAGE_KEYS.USERS, normalizedList);
	}
	return normalizedList;
};
// Lấy thông tin phiên đăng nhập hiện tại
export const getCurrentUser = () => {
	try {
		const isAuth = localStorage.getItem("petcare_is_authenticated") === "true";
		if (!isAuth) return null;
		const session = getStored(AUTH_STORAGE_KEYS.SESSION, null) || getStored("petcare_active_user", null) || getStored("petcare_current_user", null);
		if (!session) return null;
		// Xác thực lại trạng thái thực tế trong kho người dùng (kiểm tra khóa tài khoản thời gian thực)
		const users = getUsers();
		const liveUser = users.find((u) => u.id === session.id || u.email.toLowerCase() === (session.email || "").toLowerCase());
		if (!liveUser) {
			logout();
			return null;
		}
		if (liveUser.isLocked) {
			logout();
			return null;
		}
		// Vô hiệu hóa phiên đăng nhập cũ nếu mật khẩu đã bị đổi sau thời điểm xác thực của phiên
		if (liveUser.passwordChangedAt && session.authTime) {
			const changedTime = new Date(liveUser.passwordChangedAt).getTime();
			const sessionTime = new Date(session.authTime).getTime();
			if (sessionTime < changedTime) {
				console.warn("[PetCare Auth] Phiên đăng nhập đã bị hủy do mật khẩu tài khoản đã thay đổi.");
				logout();
				return null;
			}
		}
		// Luôn phản ánh đúng role và vetStatus mới nhất của tài khoản
		const sanitizedSession = {
			...liveUser,
			authTime: session.authTime || new Date().toISOString()
		};
		delete sanitizedSession.password;
		return sanitizedSession;
	} catch {
		return null;
	}
};
// Đăng nhập bằng Email & Password (Xác thực Backend qua API, kiểm tra tài khoản bị khóa và mật khẩu băm)
export const login = async (email, password, rememberMe = true) => {
	const cleanEmail = (email || "").trim().toLowerCase();
	if (!cleanEmail) {
		throw new Error("Vui lòng nhập địa chỉ Email.");
	}
	if (!password) {
		throw new Error("Vui lòng nhập Mật khẩu.");
	}
	let sessionUser = null;
	let serverSuccess = false;
	// 1. Thử xác thực trực tiếp qua Backend API
	try {
		const response = await fetch("/api/auth/login", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({
				email: cleanEmail,
				password
			})
		});
		const data = await response.json().catch(() => ({}));
		if (response.ok && data.success && data.user) {
			serverSuccess = true;
			sessionUser = {
				...data.user,
				authTime: data.authTime || new Date().toISOString()
			};
			// Đồng bộ thông tin người dùng mới nhất từ server vào kho local
			const localUsers = getUsers();
			const idx = localUsers.findIndex((u) => u.email.toLowerCase() === cleanEmail);
			if (idx !== -1) {
				localUsers[idx] = {
					...localUsers[idx],
					...data.user
				};
			} else {
				localUsers.push(data.user);
			}
			setStored(AUTH_STORAGE_KEYS.USERS, localUsers);
		} else if (response.status === 401 || response.status === 403 || response.status === 400) {
			// Backend phản hồi lỗi nghiệp vụ rõ ràng (sai mật khẩu, tài khoản bị khóa, chưa đăng ký)
			throw new Error(data.error || "Đăng nhập không thành công.");
		}
	} catch (err) {
		// Nếu là lỗi nghiệp vụ (401, 403), ném ra ngay lập tức
		if (err.message && !err.message.includes("Failed to fetch") && !err.message.includes("NetworkError") && !err.message.includes("Load failed")) {
			throw err;
		}
	}
	// 2. Dự phòng khi backend ngoại tuyến (offline fallback)
	if (!serverSuccess) {
		const users = getUsers();
		const user = users.find((u) => u.email.toLowerCase() === cleanEmail);
		if (!user) {
			throw new Error("Tài khoản email này chưa được đăng ký trong hệ thống.");
		}
		if (user.isLocked) {
			throw new Error("Tài khoản này đã bị khóa bởi Quản trị viên hệ thống. Vui lòng liên hệ hỗ trợ để biết thêm chi tiết.");
		}
		// Nếu mật khẩu trong local chưa băm và khớp
		if (user.password !== password) {
			throw new Error("Mật khẩu không chính xác. Vui lòng kiểm tra lại!");
		}
		sessionUser = {
			...user,
			authTime: new Date().toISOString()
		};
		delete sessionUser.password;
	}
	// Lưu phiên làm việc
	setStored(AUTH_STORAGE_KEYS.SESSION, sessionUser);
	setStored(AUTH_STORAGE_KEYS.REMEMBER, Boolean(rememberMe));
	try {
		localStorage.setItem("petcare_active_user", JSON.stringify(sessionUser));
		localStorage.setItem("petcare_current_user", JSON.stringify(sessionUser));
		localStorage.setItem("petcare_is_authenticated", "true");
		if (rememberMe) {
			localStorage.setItem("petcare_remembered_email", cleanEmail);
		} else {
			localStorage.removeItem("petcare_remembered_email");
		}
	} catch {}
	sound?.playSuccess?.();
	return sessionUser;
};

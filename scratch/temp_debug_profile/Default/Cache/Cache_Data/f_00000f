export const safeFormatDate = (dateStr) => {
	try {
		if (!dateStr) return "Chưa đặt ngày";
		const d = new Date(dateStr);
		return isNaN(d.getTime()) ? String(dateStr) : d.toLocaleDateString("vi-VN", {
			day: "2-digit",
			month: "2-digit",
			year: "numeric"
		});
	} catch {
		return dateStr ? String(dateStr) : "Chưa đặt ngày";
	}
};
